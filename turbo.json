{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig*.json",
    "eslint.config.js",
    "vite.config.ts",
    "tailwind.config.cjs",
    "packages/backend/esbuild.config.mjs",
    ".npmrc"
  ],
  "globalEnv": ["NODE_ENV", "CI", "VITE_*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
