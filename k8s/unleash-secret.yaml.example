# =============================================================================
# Unleash Secret 模板（P1-03 T2）
# =============================================================================
# 用法：复制为 k8s/unleash-secret.yaml 并填入实际值，切勿提交真实密钥。
#   cp k8s/unleash-secret.yaml.example k8s/unleash-secret.yaml
#
# 生成密钥示例：
#   openssl rand -hex 32          # database-url 中的密码
#   openssl rand -hex 32          # admin-api-token
#
# 部署：kubectl apply -f k8s/unleash-secret.yaml
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: unleash-secret
  namespace: backtest-platform
type: Opaque
stringData:
  # PostgreSQL 连接串（Unleash 使用独立 schema）
  # 示例: postgres://unleash_user:<password>@pg-primary.backtest.svc:5432/unleash_db
  database-url: postgres://unleash_user:REPLACE_WITH_SECURE_PASSWORD@pg-primary.backtest.svc:5432/unleash_db
  # Unleash 管理 API Token（SDK 鉴权用）
  admin-api-token: REPLACE_WITH_SECURE_TOKEN
