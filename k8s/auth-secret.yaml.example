apiVersion: v1
kind: Secret
metadata:
  name: auth-tokens
type: Opaque
stringData:
  JWT_SECRET: '<REPLACE_ME_32_plus_chars>'
  AUDIT_HMAC_KEY: '<REPLACE_ME_32_plus_chars>'
  ADMIN_API_KEY: '<REPLACE_ME>'
  ENGINE_AUTH_TOKEN: '<REPLACE_ME>'
  DATA_SERVICE_AUTH_TOKEN: '<REPLACE_ME>'
  REDIS_PASSWORD: '<REPLACE_ME>'
