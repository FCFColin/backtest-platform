{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./packages/frontend/src/*"],
      "@backtest/shared": ["./packages/shared/types/index.ts"],
      "@backtest/shared/*": ["./packages/shared/*"]
    },
    "types": []
  },
  "include": ["packages/frontend/src", "packages/shared"],
  "exclude": ["node_modules"]
}
