{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "回测平台 (Backtest Platform)",
  "_comment": "T-26 / 维度7：一键开发环境，固化为代码避免多语言工具链版本漂移（技术栈以 AGENTS.md 为准，Go+TS 双语言，DADR-003/ADR-008 已退役 Rust/Python）。",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/go:1": { "version": "1.26" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [15173, 15001, 15004, 15003, 15442, 16381],
  "portsAttributes": {
    "15173": { "label": "Frontend (Vite)" },
    "15001": { "label": "API (Express)" },
    "15004": { "label": "Go engine" },
    "15003": { "label": "Data service (Go)" },
    "15442": { "label": "PostgreSQL" },
    "16381": { "label": "Redis" }
  },
  "postCreateCommand": "corepack enable && pnpm install",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "golang.go"]
    }
  },
  "remoteEnv": {
    "DATABASE_URL": "postgresql://backtest:backtest@localhost:5432/backtest",
    "REDIS_URL": "redis://localhost:6379"
  }
}
