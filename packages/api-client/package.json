{
  "name": "@backtest/api-client",
  "version": "0.1.0",
  "description": "Auto-generated TypeScript API client for Backtest Platform",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "generate": "openapi-generator-cli generate -i ../../docs/openapi.yaml -g typescript-fetch -o src --additional-properties=supportsES6=true,typescriptThreePlus=true",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@backtest/shared": "workspace:*",
    "whatwg-fetch": "^3.6.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.6"
  }
}
