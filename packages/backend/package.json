{
  "name": "@backtest/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "server:dev": "tsx src/server.ts",
    "worker": "node --import tsx src/queues/workerEntrypoint.ts",
    "worker:dev": "node --watch --import tsx src/queues/workerEntrypoint.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --banner:js=\"import{createRequire as _cr}from'module';const require=_cr(import.meta.url);\" --external:argon2 --outdir=dist",
    "build:worker": "esbuild src/queues/workerEntrypoint.ts --bundle --platform=node --format=esm --banner:js=\"import{createRequire as _cr}from'module';const require=_cr(import.meta.url);\" --external:argon2 --outdir=dist",
    "build:ssr": "vite build --config ../../vite.config.ts --ssr packages/frontend/src/entry-server.tsx --outDir dist-ssr",
    "start": "node dist/server.js",
    "start:worker": "node dist/workerEntrypoint.js",
    "typecheck": "tsc --noEmit -p ../../tsconfig.backend.json",
    "check": "tsc --noEmit -p ../../tsconfig.backend.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 10"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@backtest/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.46.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jose": "^5.10.0",
    "kafkajs": "^2.2.4",
    "minio": "^8.0.0",
    "nodemailer": "^9.0.1",
    "opossum": "^8.5.0",
    "p-limit": "^7.3.1",
    "pg": "^8.14.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.0",
    "rate-limit-redis": "^4.2.0",
    "stripe": "^17.7.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.1",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1"
  }
}
