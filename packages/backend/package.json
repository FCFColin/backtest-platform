{
  "name": "@backtest/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "worker": "node --import tsx src/queues/workerEntrypoint.ts",
    "worker:dev": "node --watch --import tsx src/queues/workerEntrypoint.ts",
    "build": "node esbuild.config.mjs src/server.ts",
    "build:worker": "node esbuild.config.mjs src/queues/workerEntrypoint.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/workerEntrypoint.js",
    "check": "tsc --noEmit -p ../../tsconfig.backend.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 10"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@backtest/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.46.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.0",
    "jose": "^5.10.0",
    "kafkajs": "^2.2.4",
    "minio": "^8.0.0",
    "nodemailer": "^9.1.0",
    "opossum": "^8.5.0",
    "p-limit": "^7.3.2",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.0",
    "rate-limit-redis": "^4.2.0",
    "stripe": "^17.7.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.1",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13"
  }
}
