# =============================================================================
# 回测平台 - 环境变量示例
# 复制本文件为 .env 后按需修改；所有配置项均有开发环境友好的默认值。
# 生产环境部署时请务必覆盖带 [生产必填] 标记的变量。
# =============================================================================

# -----------------------------------------------------------------------------
# 运行环境
# -----------------------------------------------------------------------------
# 应用运行环境：development | production | test
# - development（默认）：错误详情会返回客户端，便于调试
# - production：隐藏错误详情，需设置 ADMIN_API_KEY
# - test：测试环境
NODE_ENV=development

# SaaS 本地开发：由 scripts/dev.mjs 自动注入 SERVE_STATIC=true，API 托管 dist/（首屏秒开）
# 使用 Vite HMR 热更新时取消注释（15173 端口，首访较慢）
# SERVE_STATIC=true

# -----------------------------------------------------------------------------
# API 服务
# -----------------------------------------------------------------------------
# 后端 API 监听端口
# 兼容旧变量 PORT（API_PORT 优先级更高）
API_PORT=15001

# API 版本生命周期（DADR-046）：当前 v1 挂载 /api/v1/，至少维护至 v2 上线后 12 个月；
# 废弃端点通过 Deprecation/Sunset/Link 头（RFC 8594）通知并提前 90 天 Webhook 推送；破坏性变更必须新建版本。

# -----------------------------------------------------------------------------
# Go 引擎（唯一回测引擎，ADR-003 / ADR-008）
# -----------------------------------------------------------------------------
# Go 引擎服务地址，平台唯一的回测/分析/优化/蒙特卡洛引擎。
# Rust 引擎已退役（Go↔Rust parity 验证通过后删除）。
# 不可用时按 fail-closed 策略返回 503 + Retry-After（ADR-008），不再静默降级到 Node。
#
# 不同环境下的 URL 格式（P0-02 多实例部署支持）：
#   本地直连 http://127.0.0.1:15004；docker-compose / K8s（经 Service）http://engine-go:5004（kube-proxy 负载均衡）
GO_ENGINE_URL=http://127.0.0.1:15004

# 引擎调用超时（毫秒），须大于 Go 引擎内部 computeTimeout（90s）；默认 120000 = 90s 计算 + 30s 余量，与 BACKTEST_SYNC_TIMEOUT_MS 一致。
ENGINE_TIMEOUT_MS=120000

# -----------------------------------------------------------------------------
# Go 数据服务（主数据源）
# -----------------------------------------------------------------------------
# Go 数据服务地址；不可用时行情查询降级到 PostgreSQL（dataFacade 返回 degraded 标记），无本地 JSON 回退
GO_DATA_SERVICE_URL=http://127.0.0.1:15003

# Go 数据服务认证 token（X-Data-Service-Auth 请求头）
# 与 data-fetcher 服务的 DATA_SERVICE_AUTH_TOKEN 必须一致
# Production: use a strong random token (>= 32 chars)
DATA_SERVICE_AUTH_TOKEN=dev-data-service-auth-token

# 数据供应商 API key（data-fetcher 实时行情降级源；缺失则该供应商不可用）
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# -----------------------------------------------------------------------------
# Go 引擎认证 token（X-Engine-Auth 请求头）
# 与 engine-go 服务的 ENGINE_AUTH_TOKEN 必须一致
# Production: use a strong random token (>= 32 chars)
ENGINE_AUTH_TOKEN=dev-engine-auth-token

# -----------------------------------------------------------------------------
# 跨域配置
# -----------------------------------------------------------------------------
# 允许的 CORS 来源，多个来源用逗号分隔
# 留空或设为 "*" 表示允许所有来源（默认，开发友好）
# 生产环境建议限定来源，例如：
#   CORS_ORIGINS=http://localhost:15173,https://your-domain.com
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# 管理后台
# -----------------------------------------------------------------------------
# 管理后台 API 密钥（可吊销，DB 化存储，见 ADR-007）
# 缺失时仅告警不阻断启动；平台管理员端点不可用
ADMIN_API_KEY=

# -----------------------------------------------------------------------------
# JWT 认证（T-P1-8）
# -----------------------------------------------------------------------------
# JWT 签名密钥
# [生产必填] 当 NODE_ENV=production 时必须修改默认值，否则启动校验失败
# 开发环境使用 dev 默认值（H-006：缺失即 throw，必须设置）
JWT_SECRET=dev-only-jwt-secret-change-in-production

# JWT Access Token 有效期（秒），默认 900（15 分钟），短期有效降低泄露风险
# JWT_ACCESS_TTL=900

# JWT Refresh Token 有效期（秒），默认 604800（7 天），用于无感刷新 Access Token
JWT_REFRESH_TTL=604800

# -----------------------------------------------------------------------------
# PostgreSQL 数据库（ADR-002）
# -----------------------------------------------------------------------------
# 数据库连接 URL（PostgreSQL 16+）
# [生产必填] 当 NODE_ENV=production 时必须通过环境变量设置
# 格式：postgresql://用户名:密码@主机:端口/数据库名；生产须用 ?sslmode=require（TLS）。
# T-21b：应用运行期使用最小权限角色 backtest_app（DDL 由迁移账户执行）
DATABASE_URL=postgresql://backtest_app:backtest_app_dev@localhost:15442/backtest
# 连接池最大连接数（默认 20）
# DB_POOL_MAX=20
# 连接池最小空闲连接数（默认 2）
# DB_POOL_MIN=2

# 只读副本连接 URL（P1-02 读写分离）
# 设置后 readPool 路由到副本减轻主库读压力；连接失败自动降级到主库。
# 生产环境指向 RDS Read Replica，须使用 ?sslmode=require；本地无内置副本（见 docker-compose.yml）
# 不设置则 readPool 回退到主库（单节点模式）
# DATABASE_READ_URL=postgresql://backtest:backtest@read-replica:5432/backtest

# -----------------------------------------------------------------------------
# Redis（DADR-018 / DADR-045 Sentinel 高可用）
# -----------------------------------------------------------------------------
# --- Production Redis (Sentinel, 必填) ---
# 生产环境必须配置 REDIS_SENTINELS，否则启动即 throw（P0-3 生产断言）；单机 Redis 是单点故障。
# --- Development Redis (Standalone, 仅开发) ---
# 开发环境用 REDIS_URL 单实例模式（零额外依赖）；本地 compose override 暴露 redis 于 127.0.0.1:16381；本地原生 Redis 用 6379。
REDIS_URL=redis://localhost:16381

# Redis Sentinel 节点列表（DADR-045 生产高可用）：逗号分隔 host:port，设置后 ioredis 启用 Sentinel 模式。
# 生产环境 [生产必填]；未设置时回退 REDIS_URL 单实例模式（开发环境）。
# 示例（K8s）：redis-0.redis:26379,redis-1.redis:26379,redis-2.redis:26379
# 示例（docker-compose）：127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
# REDIS_SENTINELS=

# Sentinel 监控的 master 名称（须与 sentinel.conf 中 `sentinel monitor <name>` 一致）。
# REDIS_SENTINEL_NAME=mymaster

# Redis 认证密码（可选，Sentinel 与单实例共用；生产环境通过 Secret 注入）。
# REDIS_PASSWORD=

# T-32：开发环境显式跳过 JWT（仅 development + true）
DEV_SKIP_AUTH=false

# T-29：调试端点 Bearer 令牌（未设置则 /api/v1/debug/* 返回 404）
DEBUG_AUTH_TOKEN=

# 运维端点 Bearer 令牌（/ready / /metrics）
# 未设置时允许匿名访问（开发/内网场景）；生产环境建议设置
METRICS_AUTH_TOKEN=

# 审计日志与缓存完整性校验 HMAC 密钥
# [生产必填] 长度 >= 32，用于审计日志签名与缓存文件完整性校验
AUDIT_HMAC_KEY=

# T-19：同步回测超时（毫秒）
BACKTEST_SYNC_TIMEOUT_MS=120000

# 同步计算端点超时（毫秒），BullMQ 不可用回退同步执行时生效
# 默认 30000（30 秒）
SYNC_COMPUTE_TIMEOUT_MS=30000

# 反向代理跳数（Express trust proxy，用于正确识别客户端 IP 以限流）
# [生产必填] 部署在 LB/Ingress 后设为代理层数（通常 1）；API 可被客户端直连时设为 0
# TRUST_PROXY_HOPS=1

# 计算端点（/api/backtest/*）限流上限，默认 10 req/min
# COMPUTE_RATE_LIMIT_MAX=10
# 禁用全部限流（仅本地开发调试用）
# DISABLE_RATE_LIMIT=true
# 响应体最大字节数，默认 50MB
# MAX_RESPONSE_BODY_SIZE=52428800
# Go 数据服务调用超时（毫秒），默认 5000
# GO_DATA_SERVICE_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# 应用基址（ADR-009）：用于注册验证 / 邀请 / 计费跳转链接拼接
# -----------------------------------------------------------------------------
APP_BASE_URL=http://localhost:15173
# Vite 开发服务器端口（前端）
VITE_PORT=15173

# -----------------------------------------------------------------------------
# 邮件发送（ADR-009，自助注册 / 组织邀请）
# -----------------------------------------------------------------------------
# 传输方式：console（默认，开发环境仅把链接打印到日志，不实际发信）| smtp（生产）
EMAIL_TRANSPORT=console
# 发件人地址
EMAIL_FROM="Backtest Platform <no-reply@backtest.platform>"
# SMTP 配置（EMAIL_TRANSPORT=smtp 时 EMAIL_SMTP_HOST 必填）
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=

# -----------------------------------------------------------------------------
# Stripe 计费（ADR-010）：留空则计费端点返回 503（计费未启用），不影响其余功能
# -----------------------------------------------------------------------------
# 使用 test-mode 密钥（sk_test_... / pk_test_... / whsec_...）
STRIPE_SECRET_KEY=
# P2-4: Webhook Secret 需从 Stripe Dashboard 分环境获取
# - production: K8s Secret 中配置 whsec_production_xxx
# - staging:    K8s Secret 中配置 whsec_staging_xxx
# - development: 本地 .env 配置 whsec_test_xxx（Stripe CLI 生成）
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# 各付费计划对应的 Stripe Price ID（price_...）
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# -----------------------------------------------------------------------------
# 其余可调项（默认值已内建）以 packages/backend/src/config/env.ts 为权威源：
# JWT_ALGORITHM/密钥文件、ANOMALY_LOGIN_*、SESSION_IDLE_TIMEOUT_*、AUDIT_RETENTION_DAYS、
# OUTBOX_RETENTION_DAYS、DB_STATEMENT_TIMEOUT_MS、DB_POOL_MAX/MIN、MINIO_*、KAFKA_*、CDC_KAFKA_ENABLED、WORKER_CONCURRENCY 等
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# AlertManager 告警通知（飞书 / 钉钉 Webhook）
# -----------------------------------------------------------------------------
# 飞书自定义机器人 webhook URL（P1-10 告警体系）
# 未设置时 receiver 静默不发，便于本地无 webhook 验证
FEISHU_WEBHOOK=
# 钉钉自定义机器人 webhook URL（P0 告警双通道）
DINGTALK_WEBHOOK=

# -----------------------------------------------------------------------------
# OpenTelemetry 链路追踪（OTLP 导出端点）
# -----------------------------------------------------------------------------
# traces 导出端点（Jaeger / Tempo / OTel Collector）；未设置时无导出（Node/Go 均不落 stdout exporter，日志经 pino/slog 输出）。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# metrics 经 prom-client 拉取模型（/metrics 端点，ADR-006 指标不走 OTLP 导出）。
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318

# -----------------------------------------------------------------------------
# WAL-G 备份配置（P0-06，等保三级 8.1.4 数据备份与恢复）
# -----------------------------------------------------------------------------
# WAL-G 使用 MinIO（S3 兼容）作为备份存储目标，支持 PITR；postgres 服务已配置 archive_command 自动归档，
# ofelia 调度器每日 02:00 CST 触发全量备份。bucket 名称在 compose/k8s 清单中硬编码。
# WAL-G 压缩算法：brotli（最佳压缩率）| lz4（最快）| gzip（兼容性）
WALG_COMPRESSION_METHOD=brotli
